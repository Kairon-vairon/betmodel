# Copy to .env (live) or .env.lab (lab) on the server and fill in. Never commit these files.
# Generate random values with:  openssl rand -hex 32

# --- App ---
APP_ENV=live                 # live | lab (the lab can never send alerts)
APP_SECRET_KEY=              # openssl rand -hex 32  (encrypts the 2FA secret; keep it safe)
OWNER_EMAIL=                 # your email: the sign-in name
TZ=Australia/Sydney

# --- Public address (live only) ---
DOMAIN=                      # e.g. edgewise.example.com, pointed at the server's IP address

# --- Database (Docker builds the connection string from these) ---
POSTGRES_USER=edgewise
POSTGRES_PASSWORD=           # openssl rand -hex 24  (letters and digits only)
POSTGRES_DB=edgewise

# --- Data feeds (Milestone 2) ---
ODDS_API_KEY=
FOOTBALL_DATA_API_KEY=

# --- Betfair (read-only in Phase 1) ---
BETFAIR_APP_KEY=
BETFAIR_USERNAME=
BETFAIR_PASSWORD=
BETFAIR_CERT_PATH=

# --- Notifications (live only; stripped from lab) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Claude API (analyst features, later phase) ---
ANTHROPIC_API_KEY=
